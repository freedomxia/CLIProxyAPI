# Copy this file to `.env` before running docker compose.

# Docker build context for the cloned notion2api repository.
NOTION2API_DIR=../../../_references/notion2api

# Public ports on the host.
CLI_PROXY_PORT=8317
NOTION2API_PORT=8000

# Client-facing API key for CLIProxyAPI.
CLI_PROXY_API_KEY=replace-with-your-cli-proxy-api-key

# Upstream API key expected by notion2api itself.
NOTION2API_API_KEY=replace-with-your-notion2api-api-key

# notion2api runtime mode: lite / standard / heavy.
NOTION2API_APP_MODE=standard

# Heavy mode only. Leave empty for lite/standard.
SILICONFLOW_API_KEY=

# Notion account pool JSON array.
NOTION_ACCOUNTS=[{"token_v2":"replace-me","space_id":"replace-me","user_id":"replace-me","space_view_id":"optional","user_name":"optional","user_email":"optional"}]

# Common runtime settings.
TZ=Asia/Shanghai
NOTION2API_ALLOWED_ORIGINS=*
